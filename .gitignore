# 编译中间文件（不入库）
build/

# dist/ 下的最终 PDF 需要随代码一并发布，故不忽略。
# math/refs/ 下的参考书 PDF 与其 OCR 全文亦入库（见 math/refs/readme.md）。
# 除此之外的 PDF 一律不入库。
*.pdf
!dist/*.pdf
!math/refs/*.pdf

# LaTeX 中间文件（正常情况下都在 build/ 里，此处兜底）
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# 编辑器
.vscode/
.idea/
*.swp
*~
.DS_Store


# Lean 4：依赖与编译产物约 5 GB，不入库。
# 但 lean-toolchain、lakefile.toml 与 lake-manifest.json 必须入库——
# 前两者指定工具链与依赖，后者锁定依赖的确切版本，缺了无法复现构建。
.lake/
